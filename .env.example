# Copy to .env.local and fill in. Never commit real values.

# Supabase. For local dev run `npx supabase start` and copy the URL and keys it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in booking links sent to patients (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "on" to show one-click demo logins on /login (fake accounts from supabase/seed.sql). Keep off on any shared deploy.
DEMO_LOGINS=

# Gemini (Phase 3). Server only. Used by the logistics layer, which never receives clinical values.
GEMINI_API_KEY=
