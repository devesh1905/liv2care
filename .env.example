# Copy to .env.local and fill in. Never commit real values.

# Supabase. For local dev run `npx supabase start` and copy the URL and keys it prints.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL used in booking links sent to patients (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "on" to show the "Try it yourself" role buttons on the home page: each opens a side panel where the visitor types that
# demo account's own password. Locally it also shows one-click logins on /login (seeded fake accounts). Needs the five demo users to exist.
DEMO_LOGINS=

# Secret for the daily reminder job (Vercel Cron sends it as a bearer token). Leave empty to switch the job off.
CRON_SECRET=

# Gemini (Phase 3). Server only. Used by the logistics layer, which never receives clinical values.
GEMINI_API_KEY=
# Optional. Defaults to gemma-4-26b-a4b-it (free tier; Google may use free-tier prompts to improve its products,
# ours hold only fake slot logistics). For a real pilot use a paid model, e.g. gemini-3.5-flash-lite.
GEMINI_MODEL=
# Optional. Calls per day across the whole app (default 200); each booking link also has a smaller daily limit.
AI_DAILY_CAP=

# Optional: send every message to ONE demo phone as a real WhatsApp message (Meta WhatsApp Cloud API test number).
# Leave empty to keep messages in the message log only. The token is a secret: set it in Vercel, never commit it.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# The demo phone: country code first, digits only (for example 919876543210). It must send "Hi" to the test number first.
DEMO_WHATSAPP_TO=

# Optional alternative to the Meta settings above: Twilio WhatsApp Sandbox (no Meta business verification needed). Used first when set.
# The demo phone joins the sandbox by sending Twilio's join message, then sends any message every 24 hours.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Key that encrypts the patient's phone number (AES-256-GCM), so their links can be sent to them. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Server only; set it in Vercel. Without it, the enrol form refuses a phone number. Losing the key makes stored numbers unreadable.
PHONE_ENCRYPTION_KEY=
